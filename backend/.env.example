# Optional Free Gemini API Key (if provided, enables enhanced script writing; otherwise built-in 0-key deterministic engine is used)
GEMINI_API_KEY=

# Default Audio Voice (Free Microsoft Edge Neural Voices)
# Options: en-US-AvaMultilingualNeural, en-US-JennyNeural, en-US-GuyNeural, en-IN-NeerjaNeural
DEFAULT_VOICE=en-US-AvaMultilingualNeural

# Kling AI API Credentials (image-to-video generation)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Output Resolution: 1080p (1920x1080) or 720p (1280x720)
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080
OUTPUT_FPS=30

# Directories
STORAGE_DIR=storage
OUTPUT_DIR=outputs
TEMP_DIR=temp

